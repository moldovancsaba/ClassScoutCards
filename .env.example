# ClassScout Configuration
CLASSSCOUT_BASE_URL=http://localhost:3000
CLASSSCOUT_INGEST_KEY=your-ingest-api-key-here

# MongoDB (optional, for direct writes)
MONGODB_URI=
# CRITICAL, hard-won 2026-08-06: the real database on this cluster is named "classscoutcluster" —
# NOT "classscout". The cluster name and database name are the same string, which is what makes the
# wrong-but-plausible guess so easy to make (and what actually happened, costing a long debugging
# session). Confirmed via the /api/card-bridge/diagnose route: "classscoutcluster" holds
# classscoutContentCards (12k+ docs), providers, meetupGroups, classscoutServiceLeads, etc. Get this
# wrong and every card-bridge route returns a clean 200 with zero results — no error, so it's easy to
# mistake for "no data yet" instead of "wrong database".
MONGODB_DB_NAME=classscoutcluster

# Card bridge — read-only GET /api/card-bridge/oldest-cards, for callers that can reach this app's
# HTTPS endpoint but can't open a native MongoDB connection to the main classscout app directly.
# Requires MONGODB_URI above (same Atlas cluster the main classscout app uses). A dedicated secret,
# separate from CLASSSCOUT_INGEST_KEY, so it can be rotated/revoked independently.
CARD_BRIDGE_API_KEY=
# Collection the bridge reads from — the main app's content-card pool, NOT this app's own "providers"
# generator collection above.
MONGODB_CONTENT_CARDS_COLLECTION=classscoutContentCards

# App
NODE_ENV=development
PORT=3001
