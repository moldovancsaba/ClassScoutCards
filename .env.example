# ClassScout Configuration
CLASSSCOUT_BASE_URL=http://localhost:3000
CLASSSCOUT_INGEST_KEY=your-ingest-api-key-here

# MongoDB (optional, for direct writes)
MONGODB_URI=
MONGODB_DB_NAME=classscout

# Card bridge — read-only GET /api/card-bridge/oldest-cards, for callers that can reach this app's
# HTTPS endpoint but can't open a native MongoDB connection to the main classscout app directly.
# Requires MONGODB_URI above (same Atlas cluster the main classscout app uses). A dedicated secret,
# separate from CLASSSCOUT_INGEST_KEY, so it can be rotated/revoked independently.
CARD_BRIDGE_API_KEY=
# Collection the bridge reads from — the main app's content-card pool, NOT this app's own "providers"
# generator collection above.
MONGODB_CONTENT_CARDS_COLLECTION=classscoutContentCards

# App
NODE_ENV=development
PORT=3001
